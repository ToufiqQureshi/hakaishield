# Copy to deploy/.env and fill in. Never commit the real one.

# The domain hakaishield serves. Must match the certbot certificate.
HAKAISHIELD_DOMAIN=

# Where the real site runs. 172.17.0.1 is the host as seen from inside a
# container - use it when the origin runs on the host itself rather than
# in compose. localhost inside the container is the container, not the box.
HAKAISHIELD_ORIGIN=

# Keep false when the origin serves HAKAISHIELD_DOMAIN. Set true only when
# the origin expects the hostname from HAKAISHIELD_ORIGIN instead, such as a
# separate staging hostname proxying a hosted site.
HAKAISHIELD_ORIGIN_HOST_FROM_TARGET=false

# shadow = decide nothing, record everything. Start here. Always.
HAKAISHIELD_MODE=shadow

# openssl rand -hex 32
EVIDENCE_TOKEN=

# Stable 32-byte-or-longer secret shared by all proxy instances. Generate
# once with openssl rand -hex 32; changing it invalidates active challenges.
HAKAISHIELD_CHALLENGE_SECRET=

# Required for pilot dashboard ownership, evidence and policy API.
# Supabase: Project Settings -> Database
DATABASE_URL=

# Required to verify dashboard sign-in tokens.
# Supabase: Project Settings -> API
SUPABASE_URL=

# Exact HTTPS origin serving dashboard/dist (no trailing slash). Compose
# requires this so authenticated API responses are not exposed to arbitrary
# browser origins.
HAKAISHIELD_DASHBOARD_ORIGIN=

# Candidate training sample retention. Confirm this period with the client.
HAKAISHIELD_SAMPLE_RETENTION_DAYS=30
